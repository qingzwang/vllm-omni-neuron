+# ---- H3_PROF: env-gated stage timing (set H3_PROF_FILE) ----
+import time as _h3_time
+
+
+class _H3Prof:
+    def __init__(self):
+        self.on = bool(os.environ.get("H3_PROF_FILE"))
+        self.marks: list[tuple[str, float]] = []
+        if self.on:
+            self.mark("start")
+
+    def mark(self, name: str) -> None:
+        if not self.on:
+            return
+        if torch.cuda.is_available():
+            torch.cuda.synchronize()
+        self.marks.append((name, _h3_time.time()))
+
+    def dump(self, **extra) -> None:
+        if not self.on:
+            return
+        if torch.distributed.is_initialized() and torch.distributed.get_rank() != 0:
+            return
+        with open(os.environ["H3_PROF_FILE"], "a") as f:
+            f.write(json.dumps({"kind": "pipeline", "marks": self.marks, **extra}) + "\n")
+
